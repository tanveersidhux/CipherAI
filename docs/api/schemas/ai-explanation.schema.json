{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipher-ai.local/schemas/ai-explanation.schema.json",
  "title": "AIExplanation",
  "description": "Structured explanation synthesized from verified evidence with strict indicator citations.",
  "type": "object",
  "required": [
    "summary",
    "key_findings",
    "user_guidance",
    "uncertainty_notes",
    "generated_by",
    "model",
    "validated"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 600,
      "description": "High-level plain-language summary of findings."
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "indicator_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 250
          },
          "indicator_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Must cite only indicator IDs present in the threat report."
          }
        },
        "additionalProperties": false
      }
    },
    "user_guidance": {
      "type": "string",
      "description": "Calm, prioritized behavioral advice for the user."
    },
    "uncertainty_notes": {
      "type": "string",
      "description": "Disclosures regarding analysis limitations and unknown variables."
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "llm",
        "deterministic_fallback"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "description": "Upstream LLM model identifier string, or null if generated by fallback."
    },
    "validated": {
      "type": "boolean",
      "description": "True if output passed strict schema and citation validation."
    }
  },
  "additionalProperties": false
}
