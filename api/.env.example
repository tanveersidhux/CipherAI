# =============================================================================
# CIPHER AI: Backend API Environment Variables Template
# Copy to api/.env for local development. Never commit real secrets.
# =============================================================================

# Application Environment (development | test | production)
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (comma-separated list of origins)
# In production, must be HTTPS and non-empty. Localhost is permitted in dev/test only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scanning and Payload Limits
RATE_LIMIT_SCANS_PER_MINUTE=30
MAX_URL_CHARS=2048
MAX_MESSAGE_CHARS=5000
MAX_REQUEST_BODY_BYTES=32768
TRUST_PROXY_HEADERS=false

# API Documentation Control (auto-disabled in production unless set to true)
ENABLE_API_DOCS=true

# Database (Supabase) Configuration
# Leave blank or omit in offline test mode; the API will report database: not_configured
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DB_HEALTHCHECK_TIMEOUT_SECONDS=2.0
SCAN_RETENTION_DAYS=90

# LLM & AI Intelligence Configuration (Phase 05 & Phase 10)
AI_ENABLED=true
LLM_ENABLED=true
# Provider options: gemini | anthropic | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=12.0
LLM_MAX_OUTPUT_TOKENS=900
AI_MAX_INPUT_CHARS=4000
AI_MAX_RETRIES=1
AI_CIRCUIT_BREAKER_ENABLED=false
AI_CONCURRENCY_LIMIT=4

# Phase 08 Feature Flags
FEATURE_REPUTATION=true
FEATURE_EMAIL_ANALYSIS=true
FEATURE_BATCH=true
FEATURE_EXPORT=true
FEATURE_WATCHLISTS=false
FEATURE_NOTIFICATIONS=false
FEATURE_COLLABORATION=false

# Phase 08 Reputation & Intelligence (Optional Provider Keys)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
REPUTATION_CACHE_TTL_SECONDS=21600
REPUTATION_TIMEOUT_SECONDS=4.0
REPUTATION_MAX_SCORE_CONTRIBUTION=40

# Phase 08 Batch & Email Limits
BATCH_MAX_ITEMS=25
BATCH_CONCURRENCY=3
EMAIL_MAX_BYTES=1048576

